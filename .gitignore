# Ignore ALL .env files in any directory, except the example template
.env
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example
.key

# Virtual environments
venv/
env/
.venv/

# Node / Expo (the frontend is not deployed, and node_modules must never be
# committed -- it was, which is why this repo's history is ~115MB).
node_modules/
**/node_modules/
.expo/
**/.expo/

# macOS
.DS_Store
**/.DS_Store

# Python bytecode
__pycache__/
**/__pycache__/
*.pyc
