# Non-secret deployment configuration for the EC2 host.
#
# Copy to deploy.env on the server and fill in. deploy.env is gitignored.
# SECRETS DO NOT GO IN THIS FILE -- they live in SSM Parameter Store.
#
# deploy.sh reads this with `set -a; source deploy.env`, so every value must be
# QUOTED. An unquoted value containing spaces (APP_TITLE=AI Doctor App) is read
# as an assignment plus a command, and the shell fails with "command not found".

# The hostname Caddy will request a certificate for. DNS must already point here.
DOMAIN="api.diegojrobles.com"

# Let's Encrypt sends certificate-expiry warnings here.
ACME_EMAIL="you@example.com"

# Comma-separated browser origins allowed to call the API. Must not be "*".
# Native iOS clients do not send an Origin header and are unaffected by this.
ALLOWED_ORIGINS="https://diegojrobles.com"

# Region your SSM parameters live in. Must match where you created them.
AWS_REGION="us-east-1"

# OpenRouter model slug. "openrouter/free" auto-selects an available free model
# so a single model retirement does not break the app.
MODEL="openrouter/free"

APP_REFERER="https://api.diegojrobles.com"
APP_TITLE="AI Doctor App"
